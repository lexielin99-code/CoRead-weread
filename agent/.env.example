# 复制为 .env 后填入你的配置
# 支持任何 OpenAI 兼容协议的服务商

# ── 必填 ──────────────────────────────────────────────────────────────────────
COREAD_API_KEY=
COREAD_API_BASE=
COREAD_MODEL=

# ── 常见服务商配置示例（选一个填入上方） ──────────────────────────────────────
#
# OpenAI
#   COREAD_API_BASE=https://api.openai.com/v1
#   COREAD_MODEL=gpt-4o
#
# Mimo（小米）
#   COREAD_API_BASE=https://api.xiaomimimo.com/v1
#   COREAD_MODEL=mimo-v2.5-pro
#
# DeepSeek
#   COREAD_API_BASE=https://api.deepseek.com/v1
#   COREAD_MODEL=deepseek-chat
#
# 月之暗面（Kimi）
#   COREAD_API_BASE=https://api.moonshot.cn/v1
#   COREAD_MODEL=moonshot-v1-8k
#
# Ollama（本地，无需 key）
#   COREAD_API_KEY=ollama
#   COREAD_API_BASE=http://localhost:11434/v1
#   COREAD_MODEL=llama3

# ── weread API key（仅冷启动时需要） ──────────────────────────────────────────
WEREAD_API_KEY=
